# Local development only; change these values if needed.
DB_NAME=orderflow
DB_USERNAME=orderflow
DB_PASSWORD=change-me-local-only
DB_PORT=5432
DB_URL=jdbc:postgresql://localhost:5432/orderflow
API_PORT=8080
# Required for running Spring Boot on your host (not for Maven integration tests).
JWT_ISSUER_URI=http://localhost:8081/realms/orderflow
# Local Keycloak administration only; never reuse in production.
KEYCLOAK_ADMIN_PASSWORD=local-admin-change-me
